# Copy to .env (never commit .env). docker compose reads it automatically.
# For local dev without docker, export the same names in your shell.

# ---- Postgres ---------------------------------------------------------------------------------
# docker compose builds DATABASE_URL from these three. Outside compose set DATABASE_URL directly.
POSTGRES_USER=gcc
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=gcc
# DATABASE_URL=postgresql://gcc:change-me@localhost:5432/gcc     # managed Postgres (Neon, Supabase, Render ...): add ?sslmode=require

# ---- Web app ----------------------------------------------------------------------------------
# REQUIRED in production. Signs login cookies; the server refuses to start if it is missing or the default.
#   openssl rand -hex 32
JWT_SECRET=
# Public origin, no trailing slash. Used in sitemap, RSS, emails and confirm/unsubscribe links.
SITE_URL=http://localhost:3000
# Comma-separated. Whoever signs up with one of these emails becomes admin. Set it before you sign up.
ADMIN_EMAILS=you@example.com
# test = no payment gateway, anyone can switch plans from the dashboard, yellow "TEST BUILD" bar.
# live = gateway required (NOT built yet, see DEPLOY.md before switching).
BILLING_MODE=test
# Shared secret for POST /api/billing/webhook (HMAC-SHA256 of the raw body in header x-signature). Empty = webhook answers 503.
BILLING_WEBHOOK_SECRET=
# Compose only: host bind address / port of the web container, and the HTTPS domain for `--profile caddy`.
WEB_BIND=127.0.0.1
WEB_PORT=3000
DOMAIN=gcc.example.com

# ---- Email (weekly digest + subscribe confirmations) ------------------------------------------
# Leave all empty to run without email: the digest is built but not sent, and /subscribe shows the confirm link
# on screen while BILLING_MODE=test (and logs it). Any SMTP provider works (Brevo, SES SMTP, Mailgun SMTP, Gmail app password ...).
# Either one URL ...
SMTP_URL=
#   smtp://user:pass@smtp.example.com:587     STARTTLS (587)       smtps://user:pass@smtp.example.com:465     implicit TLS
# ... or the parts:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The GCC Weekly <digest@example.com>
# SMTP_RATE=5            # digest sending speed, mails per second

# ---- Worker tuning (optional) -----------------------------------------------------------------
# ATS_BUDGET=1500        # seconds the weekly job-board sweep may run
# ENRICH_LIMIT=300       # companies enriched from Wikidata per weekly run
# BATCH=500              # companies refreshed per refresh.py run
# STORY_PAGES=1          # force RSS links to /story/[id] (auto-detected otherwise)
# SKIP_MIGRATE=1         # web container: skip the boot-time schema migration
