# HTTPS reverse proxy. Caddy fetches and renews the certificate by itself; DNS for {$DOMAIN} must point at this server.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {remote_host}
	}
	# Security headers (CSP, HSTS ...) come from the app itself (web/next.config.js).
}
